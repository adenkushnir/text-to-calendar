<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the pretend-a-notification, show-the-summary, leave-by-now and check-Gmail receivers, which
     only adb (holding the DUMP permission) can call -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".PretendNotificationReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.adenkushnir.datebook.PRETEND_NOTIFICATION" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ShowSummaryReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.adenkushnir.datebook.SHOW_SUMMARY" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".LeaveByNowReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.adenkushnir.datebook.LEAVE_BY_NOW" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".CheckGmailReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.adenkushnir.datebook.CHECK_GMAIL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
